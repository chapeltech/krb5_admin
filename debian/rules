#!/usr/bin/make -f

include /usr/share/dpkg/architecture.mk

PERL_VENDOR_ARCH := $(shell perl -MConfig -le 'print $$Config{installvendorarch};')
PERL_VENDOR_LIB := $(shell perl -MConfig -le 'print $$Config{installvendorlib};')
KRB5_ENV := KRB5TYPE=heimdal KRB5DIR=/usr/lib/asgard \
	KRB5INCDIR=/usr/include/asgard/heimdal \
	KRB5LIBDIR=/usr/lib/$(DEB_HOST_MULTIARCH)/asgard/lib

ifneq ($(DEB_BUILD_MULTIARCH),$(DEB_HOST_MULTIARCH))
PERL_VENDOR_ARCH := $(subst $(DEB_BUILD_MULTIARCH),$(DEB_HOST_MULTIARCH),$(PERL_VENDOR_ARCH))
endif

%:
	dh $@

override_dh_auto_configure:
	$(KRB5_ENV) dh_auto_configure
	$(KRB5_ENV) dh_auto_configure \
	    --buildsystem=perl_makemaker --sourcedirectory=Krb5Admin \
	    -- PREFIX=/usr

override_dh_auto_install:
	set -e; PERL_VENDOR_ARCH=$(PERL_VENDOR_ARCH); \
	PERL_VENDOR_LIB=$(PERL_VENDOR_LIB); \
	for file in libkrb5admin-perl.install; \
	do \
		sed -e"s,\$${PERL_VENDOR_ARCH},$${PERL_VENDOR_ARCH#/},g" \
		    -e"s,\$${PERL_VENDOR_LIB},$${PERL_VENDOR_LIB#/},g" \
			debian/$${file}.in > debian/$$file; \
	done
	dh_auto_install
	$(MAKE) -C Krb5Admin install DESTDIR=$(CURDIR)/debian/tmp

override_dh_strip:
	: "don't"

override_dh_auto_test:
ifeq ($(DEB_BUILD_MULTIARCH),$(DEB_HOST_MULTIARCH))
	perl -Iblib/lib -Iblib/arch -IKrb5Admin/blib/lib \
	    -IKrb5Admin/blib/arch -c scripts/prestash-notify
	dh_auto_test
else
	: "tests require the target Perl runtime"
endif

override_dh_builddeb:
	dh_builddeb -- -Zgzip
