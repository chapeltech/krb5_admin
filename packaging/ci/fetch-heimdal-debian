#!/bin/sh

set -eu

: "${PACKAGING_DIR:?PACKAGING_DIR must be set}"
: "${TARGET_ARCHITECTURE:?TARGET_ARCHITECTURE must be set}"
: "${GH_TOKEN:?GH_TOKEN must be set}"

if [ "$#" -ne 1 ] || [ -z "$1" ]; then
	echo "usage: $0 OUTPUT_DIRECTORY" >&2
	exit 2
fi

. "$PACKAGING_DIR/packaging/heimdal-release.env"

output_dir=$1
work_dir=$(mktemp -d)
trap 'rm -rf "$work_dir"' EXIT HUP INT TERM

for name in clients devel kdc libs; do
	file=asgard-heimdal-${name}_${HEIMDAL_DEBIAN_VERSION}
	file=${file}_${TARGET_ARCHITECTURE}.deb
	gh release download "$HEIMDAL_RELEASE" \
		--repo "$HEIMDAL_REPOSITORY" --pattern "$file" \
		--dir "$work_dir"
done
gh release download "$HEIMDAL_RELEASE" \
	--repo "$HEIMDAL_REPOSITORY" --pattern SHA256SUMS \
	--dir "$work_dir"

selected_sums=$work_dir/SHA256SUMS.selected
grep "_${TARGET_ARCHITECTURE}[.]deb$" "$work_dir/SHA256SUMS" \
	>"$selected_sums"
test "$(wc -l <"$selected_sums")" -eq 4
(
	cd "$work_dir"
	sha256sum -c "$(basename "$selected_sums")"
)

expected_names=$work_dir/expected-names
actual_names=$work_dir/actual-names
printf '%s\n' \
	asgard-heimdal-clients \
	asgard-heimdal-devel \
	asgard-heimdal-kdc \
	asgard-heimdal-libs >"$expected_names"
: >"$actual_names"

for package in "$work_dir"/*.deb; do
	test "$(dpkg-deb -f "$package" Architecture)" = "$TARGET_ARCHITECTURE"
	test "$(dpkg-deb -f "$package" Version)" = "$HEIMDAL_DEBIAN_VERSION"
	dpkg-deb -f "$package" Package >>"$actual_names"
done
LC_ALL=C sort -o "$actual_names" "$actual_names"
cmp "$expected_names" "$actual_names"

mkdir -p "$output_dir"
cp "$work_dir"/*.deb "$output_dir/"
